# Copy to .env and fill in. .env is gitignored, never commit real keys.
COHERE_API_KEY=your-cohere-key-here

# Optional overrides (defaults shown)
COHERE_MODEL=command-r-plus
EMBEDDING_MODEL=BAAI/bge-m3
RELEVANCE_THRESHOLD=0.54
# Arabic queries score ~0.11 lower than equivalent English ones against an
# English catalogue; measured by scripts/calibrate_threshold.py
ARABIC_THRESHOLD_OFFSET=0.11
TOP_K_PER_QUERY=3
AMAZON_COUNTRY=eg
MAX_ROUNDS=3
SCRAPE_DELAY_SECONDS=1.5
